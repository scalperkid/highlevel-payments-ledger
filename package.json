{
  "name": "payments-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 migrations apply ledger --local --persist-to .wrangler/state && wrangler d1 execute ledger --local --persist-to .wrangler/state --file scripts/seed-dev.sql",
    "db:remote": "wrangler d1 migrations apply ledger --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.40.0"
  }
}
